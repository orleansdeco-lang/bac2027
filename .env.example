# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Site URL
NEXT_PUBLIC_SITE_URL=https://shater.dz

# Google Analytics 4 (GA4)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Meta Pixel (Browser Client-Side)
NEXT_PUBLIC_META_PIXEL_ID=1234567890123456

# Meta Conversions API (Server-Side CAPI - STRICTLY PRIVATE, NEVER COMMIT OR EXPOSE TO CLIENT)
META_PIXEL_ID=1234567890123456
META_ACCESS_TOKEN=EAAG...your_meta_system_user_token_here
# Optional: Test event code from Meta Events Manager (e.g. TEST12345) to view events in real-time test console
META_TEST_EVENT_CODE=

# Marketing Analytics Debug Mode (true/false)
NEXT_PUBLIC_ANALYTICS_DEBUG=false

# Phone Verification OTP (Server-Side Secret Pepper - STRICTLY PRIVATE)
OTP_PEPPER=generate-a-strong-random-secret-pepper-at-least-32-characters

# Meta WhatsApp Cloud API (Server-Side Only)
WHATSAPP_API_TOKEN=EAAG...your_whatsapp_system_user_token_here
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_TEMPLATE_NAME=shater_otp_verification
WHATSAPP_LANGUAGE_CODE=ar

